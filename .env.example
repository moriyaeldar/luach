# Copy to .env and change for any shared or public environment.
POSTGRES_PASSWORD=postgres
TASKS_DB_PASSWORD=tasks
HOUSEHOLDS_DB_PASSWORD=households

# Signs the session cookie and the tokens the gateway relays to the services (at least 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-0123456789

# Optional: "Sign in with Google". Without these, only the demo login is offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
